# REQUIRED in production
BIZ_HUB_SECRET_KEY=replace-with-a-long-random-secret
BIZ_HUB_ADMIN_USERNAME=replace-with-your-admin-username
BIZ_HUB_ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Optional: set to 1 only when first-time public admin bootstrap is intentionally enabled.
BIZ_HUB_ALLOW_ADMIN_SIGNUP=0

# Set to 1 when BizHub is served over HTTPS.
BIZ_HUB_COOKIE_SECURE=1

# Optional WhatsApp number used for BizHub subscription/payment contact.
BIZ_HUB_PAYMENT_WHATSAPP=233558272972

# Optional email/WhatsApp/browser push integrations.
# BIZ_HUB_SMTP_HOST=
# BIZ_HUB_SMTP_PORT=587
# BIZ_HUB_SMTP_USERNAME=
# BIZ_HUB_SMTP_PASSWORD=
# BIZ_HUB_SMTP_FROM=BizHub
# BIZ_HUB_TWILIO_ACCOUNT_SID=
# BIZ_HUB_TWILIO_AUTH_TOKEN=
# BIZ_HUB_TWILIO_WHATSAPP_FROM=
# BIZ_HUB_FIREBASE_CREDENTIALS=/secure/path/firebase-service-account.json
# BIZ_HUB_VAPID_SUBJECT=mailto:notifications@your-domain.example
